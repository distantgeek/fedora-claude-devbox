# Secrets and credentials — never commit
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*_rsa
*_ed25519
*_ecdsa
*_dsa
*.pub
credentials/
secrets/
token
vault_pass*
*.secret
*.credential

# Proxmox token (handled by ~/.config/proxmox/token — not in repo)
config/proxmox/
~/.config/proxmox/

# OpenCode local settings — not portable
.opencode/
.mcp/

# Session certs — never commit
.config/opencode/sessions/
~/.config/opencode/sessions/
*session*.cert

# SSH CA key — never commit
.ssh/ca/

# Ansible runtime artifacts
ansible/deployment.log
ansible/*.retry
ansible/.external-roles/
ansible/.external-tools/
ansible/inventories/hosts
ansible/inventories/production
*.inventory

# Build artifacts
output/
output/disk.raw
*.raw
*.qcow2
*.img

# OS / editor
.DS_Store
Thumbs.db
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo
*~
.direnv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Node
node_modules/
.npm-global/
.npm/

# Rust
target/

# Logs
*.log
logs/

# Playwright / Puppeteer browser caches
.cache/puppeteer/
.cache/ms-playwright/
.local/bin/browse*
.local/bin/playwright*

# Python build artifacts (vendored packages)
*.egg-info/
vendor/*/build/
