FROM quay.io/fedora/fedora-bootc:44

# ---------------------------------------------------------------------------
# open-atomic — VM bootc image (thin shell)
# This image is deliberately minimal. OpenCode, toolchains, SAST, and the
# security framework live in the agent container (ghcr.io/distantgeek/open-atomic-agent).
# ---------------------------------------------------------------------------

LABEL org.opencontainers.image.title="open-atomic"
LABEL org.opencontainers.image.description="Fedora bootc host for the open-atomic agent container — Podman/Quadlets/SELinux"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# ---------------------------------------------------------------------------
# System packages — minimal: container runtime + guest agent + firewall.
# No language toolchains here; they belong in the agent container.
# ---------------------------------------------------------------------------
RUN dnf install -y \
    podman \
    buildah \
    skopeo \
    podman-compose \
    firewalld \
    qemu-guest-agent \
    cloud-init \
    git \
    curl \
    python3 \
    openssh-server \
    # guest diagnostics / management (qm guest exec, hardware introspection)
    dmidecode \
    lshw \
    ethtool \
    pciutils \
    usbutils \
    nfs-utils \
    cifs-utils \
    && dnf clean all

# ---------------------------------------------------------------------------
# Enable system services.
# NOTE: podman.socket (root) is deliberately NOT enabled — the agent container
# must never see the VM's podman socket (escape vector). Rootless podman runs
# under the devbox user without a socket.
# ---------------------------------------------------------------------------
RUN systemctl enable qemu-guest-agent \
    && systemctl enable firewalld \
    && systemctl enable cloud-init-local cloud-init-main cloud-init-network cloud-final

# ---------------------------------------------------------------------------
# bootc install configuration — explicitly declare root filesystem type.
# Required by bootc-image-builder; do not rely on base image to provide it.
# ---------------------------------------------------------------------------
RUN mkdir -p /usr/lib/bootc/install && \
    printf '[install.filesystem.root]\ntype = "xfs"\n' \
    > /usr/lib/bootc/install/10-open-atomic.toml

# ---------------------------------------------------------------------------
# grant-session — mints short-lived SSH certificates for remote management.
# The CA private key lives in ~/.ssh/ca/ (host-only, never mounted into the
# agent container).
# ---------------------------------------------------------------------------
RUN mkdir -p /usr/local/lib/open-atomic /etc/skel/.config/opencode/sessions /etc/skel/.config/open-atomic
COPY scripts/grant-session /usr/local/bin/grant-session
COPY config/quadlets/agent.env.example /etc/skel/.config/open-atomic/agent.env.example
RUN chmod 0755 /usr/local/bin/grant-session

# ---------------------------------------------------------------------------
# Rootless Podman config skeleton
# ---------------------------------------------------------------------------
RUN mkdir -p /etc/skel/.config/containers
COPY config/containers/ /etc/skel/.config/containers/

# ---------------------------------------------------------------------------
# Agent container Quadlet — starts the agent container on login/lingering.
# The agent image is pulled at runtime and can be updated without a VM rebuild.
# ---------------------------------------------------------------------------
RUN mkdir -p /etc/skel/.config/containers/systemd
COPY config/quadlets/opencode-agent.container /etc/skel/.config/containers/systemd/opencode-agent.container

# ---------------------------------------------------------------------------
# Shell integrations for /etc/skel/.bashrc
# ---------------------------------------------------------------------------
RUN cat >> /etc/skel/.bashrc << 'EOF'

# --- open-atomic shell integrations ---

# Enter the agent container
alias open-atomic='podman exec -it opencode-agent bash'

# Session-grant helper
alias grant='grant-session'

# Podman aliases (Docker-compatible muscle memory)
alias docker='podman'
alias docker-compose='podman-compose'
EOF

# ---------------------------------------------------------------------------
# Operator SSH public key — injected at build time via SSH_AUTHORIZED_KEYS.
# Written to /etc/skel/.ssh/authorized_keys so useradd -m copies it into the
# user's home. NO password is set on any account (root and the user are
# locked) — SSH key auth is the ONLY way in.
# ---------------------------------------------------------------------------
ARG SSH_AUTHORIZED_KEYS=""
RUN mkdir -p /etc/skel/.ssh \
    && chmod 700 /etc/skel/.ssh \
    && if [ -n "$SSH_AUTHORIZED_KEYS" ]; then \
         printf '%s\n' "$SSH_AUTHORIZED_KEYS" > /etc/skel/.ssh/authorized_keys; \
         chmod 600 /etc/skel/.ssh/authorized_keys; \
       fi

# ---------------------------------------------------------------------------
# Primary user — configurable at build time, defaults to "devbox"
# NO sudo, NO wheel, NO podman groups — the user is unprivileged. System
# changes happen at build time; remote elevation is via short-lived SSH certs.
# Must run after all /etc/skel setup so useradd -m copies the full skel.
# ---------------------------------------------------------------------------
ARG DEVBOX_USER=devbox
RUN useradd -m -s /bin/bash ${DEVBOX_USER}
