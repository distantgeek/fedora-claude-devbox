# open-atomic environment configuration
# Copy to .env and populate before running make deploy
# NEVER commit .env to git

# ---------------------------------------------------------------------------
# Proxmox API (sourced from ~/.config/proxmox/token on the operator machine)
# Used by Ansible proxmox_* modules and connectivity checks.
# ---------------------------------------------------------------------------
PROXMOX_HOST=192.168.2.2
PROXMOX_USER=opencode@pve
PROXMOX_TOKEN_NAME=opencode0
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Devbox deployment
# ---------------------------------------------------------------------------
VM_HOST=192.168.x.x            # devbox VM IP (set DHCP reservation)
VM_USER=devbox
SSH_KEY=~/.ssh/id_ed25519

# ---------------------------------------------------------------------------
# Git user config (applied globally on the devbox)
# ---------------------------------------------------------------------------
GIT_USER_NAME=kevbot
GIT_USER_EMAIL=cooperke@distantgeek.net

# ---------------------------------------------------------------------------
# GitHub (for gh CLI, GHCR pushes)
# ---------------------------------------------------------------------------
GITHUB_USERNAME=kevbot
GITHUB_PAT=ghp_...

# ---------------------------------------------------------------------------
# Additional Git servers (pattern: GIT_{NAME}_{FIELD})
# GIT_COMPANY_URL=https://gitlab.company.com
# GIT_COMPANY_USERNAME=yourusername
# GIT_COMPANY_PAT=glpat-...
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Repository auto-clone (pattern: GIT_REPO_{N}_{FIELD})
# Repos are cloned to GIT_REPOS_BASE_DIR on the devbox.
# ---------------------------------------------------------------------------
MANAGE_GIT_REPOSITORIES=false
GIT_REPOS_BASE_DIR=~/repos
GIT_UPDATE_EXISTING=true

# GIT_REPO_1_URL=https://github.com/distantgeek/open-atomic.git
# GIT_REPO_1_BRANCH=main
# GIT_REPO_1_DEPTH=0
# GIT_REPO_1_POST_CLONE=

# ---------------------------------------------------------------------------
# MCP server API keys — injected at agent-container build time, not deploy.
# ---------------------------------------------------------------------------
GITHUB_PAT=ghp_...
CONTEXT7_API_KEY=
