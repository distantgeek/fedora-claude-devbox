{
  "_comment": "Opencode settings - multi-platform devbox config. MCP servers and agents configured in opencode.jsonc.",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
