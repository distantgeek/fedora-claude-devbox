{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "autoupdate": true,
  "snapshot": true,

  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],

  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}"
      },
      "enabled": true
    },
    "cve": {
      "type": "local",
      "command": ["uvx", "cve-mcp-server"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["context7-cache-proxy"],
      "env": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "duckduckgo-search": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/repos"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },

  "instructions": [
    "/opt/open-atomic/opencode/instructions/security-guidelines.md",
    "/opt/open-atomic/opencode/instructions/cis-hardening.md",
    "/opt/open-atomic/opencode/instructions/code-quality.md",
    "/opt/open-atomic/opencode/instructions/delegation.md",
    "/opt/open-atomic/opencode/instructions/hallucination-lessons.md",
    "/opt/open-atomic/opencode/instructions/caveman.md",
    "/opt/open-atomic/opencode/instructions/ponytail.md"
  ],

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rm -rf *": "deny"
    },
    "read": {
      ".env*": "deny",
      "*credentials*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "task": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "webfetch": "allow",
    "external_directory": "ask"
  },

  "agent": {
    "security-auditor": {
      "description": "Security auditing agent. Invoke for: vulnerability scanning, CVE checks, dependency audits, Docker/K8s/IaC security review, hardcoded secrets detection, injection pattern analysis, cryptography review. Uses CVE MCP and language-specific security skills.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:/opt/open-atomic/opencode/agents/security-auditor.md}",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "bandit *": "allow",
          "gosec *": "allow",
          "cargo-audit *": "allow",
          "cargo-deny *": "allow",
          "npm audit*": "allow",
          "hadolint *": "allow",
          "trivy *": "allow",
          "kube-linter *": "allow",
          "checkov *": "allow",
          "semgrep *": "allow",
          "pip-audit *": "allow",
          "govulncheck *": "allow",
          "flawfinder *": "allow",
          "cargo-geiger *": "allow"
        }
      },
      "color": "#ef4444"
    },
    "code-reviewer": {
      "description": "Code review agent. Invoke for: code quality reviews, SOLID principle checks, readability assessment, complexity analysis, error handling review, test coverage evaluation. Read-only — does not modify files.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:/opt/open-atomic/opencode/agents/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": "allow"
      },
      "color": "#8b5cf6"
    },
    "docs-writer": {
      "description": "Documentation agent. Invoke for: writing or updating README, API docs, architecture docs, contributing guides, inline code documentation, ISO/IEC 26514 compliance. Can edit documentation files only.",
      "mode": "subagent",
      "temperature": 0.3,
      "prompt": "{file:/opt/open-atomic/opencode/agents/docs-writer.md}",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      },
      "color": "#10b981"
    },
    "refactor": {
      "description": "Refactoring agent. Invoke for: restructuring code without changing behavior, extracting functions, renaming variables, consolidating duplicates, simplifying conditionals, introducing parameter objects. Preserves security properties and test coverage.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:/opt/open-atomic/opencode/agents/refactor.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "color": "#f59e0b"
    },
    "project-auditor": {
      "description": "Full codebase audit agent. Invoke for: retroactive project audits, hallucination risk detection, structural analysis, comprehensive security scanning across the entire codebase. Read-only — does not modify files.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:/opt/open-atomic/opencode/agents/project-auditor.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "read": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "bandit *": "allow",
          "gosec *": "allow",
          "cargo-audit *": "allow",
          "cargo-deny *": "allow",
          "cargo-geiger *": "allow",
          "hadolint *": "allow",
          "trivy *": "allow",
          "checkov *": "allow",
          "semgrep *": "allow",
          "pip-audit *": "allow",
          "govulncheck *": "allow",
          "python3 *": "allow"
        }
      },
      "color": "#8b5cf6"
    },
    "spec-assessor": {
      "description": "Spec validation agent. Invoke for: reviewing feature specifications, detecting ambiguity, finding contradictions, checking completeness, identifying untestable claims, flagging scope creep. Read-only — does not modify files.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:/opt/open-atomic/opencode/agents/spec-assessor.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "read": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": "deny"
      },
      "color": "#f59e0b"
    },
    "verifier": {
      "description": "Hallucination verification agent. Invoke for: verifying agent outputs for accuracy, checking package imports exist, validating API references against documentation, confirming CVE claims, detecting false security findings, cross-referencing config schemas. Automatically invoked after security-auditor, refactor, and project-auditor outputs.",
      "mode": "subagent",
      "temperature": 0.0,
      "prompt": "{file:/opt/open-atomic/opencode/agents/verifier.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "read": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "echo * >> ~/.config/opencode/hallucination-metrics.jsonl": "allow"
        }
      },
      "color": "#f43f5e"
    }
  },

  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
