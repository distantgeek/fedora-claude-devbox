# open-atomic agent credentials
# Copy to ~/.config/open-atomic/agent.env on the VM host, then chmod 600.
# The agent Quadlet injects these as env vars into the container.
# NEVER commit the real file. This example is safe (placeholder values).

# ---------------------------------------------------------------------------
# GitHub fine-grained PAT — powers the `github` MCP server.
# Scope: read access to the repos you want the agent to work with.
# ---------------------------------------------------------------------------
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Context7 API key — up-to-date library documentation MCP.
# Get one at https://context7.com
# ---------------------------------------------------------------------------
CONTEXT7_API_KEY=ctx7sk_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Proxmox API (optional — usually you'll use SSH certs via grant-session
# instead of a standing token). Uncomment + populate if the agent needs
# direct API access without a session cert.
# ---------------------------------------------------------------------------
#PROXMOX_HOST=192.168.2.2
#PROXMOX_USER=opencode@pve
#PROXMOX_TOKEN_NAME=opencode0
#PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# NOTE: model provider keys (opencode-go, openrouter, etc.) are NOT set here.
# They live in ~/.local/share/opencode/auth.json (managed via `opencode auth login`).
